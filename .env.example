# 复制本文件为 .env 后填写真实值，或者直接把内容追加到已有的 .env

# ---------- 飞书 ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- LLM（OpenAI 兼容协议） ----------
# 接口地址，注意保留末端的 /v1
LLM_BASE_URL=https://api.agicto.cn/v1/
LLM_MODEL=gemini-3.8-flash
# 也可以不填 LLM_API_KEY，直接复用环境变量中的 AGI_KEY
# LLM_API_KEY=sk-xxxxxxxx

# ---------- 运行参数 ----------
LOG_LEVEL=INFO
WORKER_THREADS=8
# 群聊中 false=只在被 @ 时回复，true=所有消息都回复
GROUP_REPLY_ALL=false

# Codex 模式通过 LangChain 调用本地 App Server，不是 ACP 或 OpenAI HTTP 接口。
REPLY_BACKEND=codex
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=180

# Codex 默认从项目目录查找文件；可设置其他已存在的本机工作目录
# CODEX_WORKSPACE=
